#!/bin/bash
# Policy Studio launcher
# Author: Luiz Garcia (Axway) (c) 2020
#
# Versions 7.7.0.20260228+ use KasmVNC (browser-based, no XQuartz).
# Earlier versions use X11 forwarding via XQuartz.

parameters=$@
command=$0

myDir="$(dirname "$command")"
source "$myDir/tools"

log()
{
  if [[ $verbose == "y" ]]
  then
    echo "$@"
  fi
}

printUsage()
{
  log "Usage:"
  log "    ./`basename $command` <version> [-p port] [-m host:container]... [--no-restart] [-v]"
  log
  log "Where:"
  log "    <version>            Required. Version like 7.5.3, 7.5.3.12, 7.5.3.13, 7.7.20.01,"
  log "                         7.7.20.03 (legacy X11) or 7.7.0.20260228 and newer"
  log "                         (KasmVNC, browser-based, no XQuartz needed)."
  log "    -p, --port <port>    Host port to map KasmVNC on (default: 6901). Use different"
  log "                         ports to run multiple instances simultaneously."
  log "    -m, --mount h:c      Map an extra host folder into the container. Repeatable."
  log "                         Same 'host:container[:ro]' syntax as 'docker -v'."
  log "    --no-restart         Do not add '--restart unless-stopped' (KasmVNC versions)."
  log "    -v, --verbose        Verbose output."
  log "    -h, --help           Show this help."
  log
  log "Examples:"
  log "    ./`basename $command` 7.5.3.13"
  log "    ./`basename $command` 7.7.0.20260228"
  log "    ./`basename $command` -p 6902 7.7.0.20260228"
  log "    ./`basename $command` 7.7.0.20260228 \\"
  log "        -m ~/git/axway-gtwy-code:/home/axway/apiprojects/axway-gtwy-code \\"
  log "        -m ~/git/axway-dmz-gtwy-code:/home/axway/apiprojects/axway-dmz-gtwy-code"
  log
}

parseOptions()
{
  help="n"
  verbose="n"
  port="6901"
  restart="y"
  extraMounts=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            help=y
            shift
            ;;
        -v|--verbose)
            verbose=y
            shift
            ;;
        -p|--port)
            if [[ -z "$2" ]]; then
              echo "Error: $1 requires a port argument." >/dev/tty
              exit 1
            fi
            port="$2"
            shift 2
            ;;
        -m|--mount)
            if [[ -z "$2" ]]; then
              echo "Error: $1 requires a host:container argument." >/dev/tty
              exit 1
            fi
            extraMounts+=("$2")
            shift 2
            ;;
        --no-restart)
            restart="n"
            shift
            ;;
        --)
            shift
            ;;
        *)
            version="$1"
            shift
            ;;
    esac
  done
}

# Returns 0 (true) if the version uses new Axway date-based naming (7.7.0.YYYYMMDD).
isKasmVncVersion()
{
  [[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]{8}$ ]]
}

# New-style: KasmVNC browser-based, no XQuartz needed.
mainKasmVnc()
{
  # Policy Studio is a linux/amd64-only image; force emulation on ARM64 Macs.
  PLATFORM="linux/amd64"

  getImageName policystudio "$version"
  initializeImage

  # apiprojects is shared across all instances of the same version.
  # configuration and licenses are also shared — only the host port differs.
  local versionDir="$HOME/axway/$version"
  mkdir -p "$versionDir/apiprojects"
  mkdir -p "$versionDir/policystudio/configuration"
  mkdir -p "$versionDir/policystudio/licenses"

  # Build the run arguments, adding any extra -m/--mount folders and the
  # restart policy (on by default so Policy Studio survives Mac sleep / VM
  # restarts; disable with --no-restart).
  local runArgs=(
    --platform linux/amd64
    -p "${port}:6901"
    -v "$versionDir/apiprojects:/home/axway/apiprojects"
    -v "$versionDir/policystudio/configuration:/opt/axway/policystudio/configuration/login"
    -v "$versionDir/policystudio/licenses:/opt/axway/policystudio/conf/licenses:ro"
  )
  [[ "$restart" == "y" ]] && runArgs+=(--restart unless-stopped)

  local m
  for m in "${extraMounts[@]}"; do
    runArgs+=(-v "$m")
  done

  log "Running $command (KasmVNC) on port $port"
  "$DOCKER" container run -d "${runArgs[@]}" "$image"

  log "Opening browser at http://localhost:${port} (credentials: axway / axway1)"
  sleep 5
  open "http://localhost:${port}"
}

# Legacy: X11/XQuartz-based.
mainLegacy()
{
  getImageName policystudio $version
  initializeImage
  initializeDisplay
  getMagicCookie

  # Check if there is already the directories for that version.
  if [[ ! -d "~/axway/policystudio/$version" ]]
  then
    log "Initializing directories."
    mkdir -p ~/axway/policystudio/$version
    ID=$("$DOCKER" container run -itd $image &) && \
      "$DOCKER" container cp $ID:/opt/axway/policystudio/configuration/ ~/axway/policystudio/$version/ && \
      "$DOCKER" container cp $ID:/opt/axway/policystudio/plugins/ ~/axway/policystudio/$version/ && \
      "$DOCKER" container stop $ID && \
      "$DOCKER" container rm $ID
  fi

  log "Running $command"
  "$DOCKER" container run -d -p 3389:3389 -p 25901:5901 -p 26901:6901 -e VNC_RESOLUTION=1920x1080 -e DISPLAY=$display -e MAGIC_COOKIE=$magicCookie -v ~/axway/apiprojects/$version:/home/axway/apiprojects -v ~/axway/policystudio/$version/configuration:/opt/axway/policystudio/configuration -v ~/axway/policystudio/$version/plugins:/opt/axway/policystudio/plugins -v ~/axway/policystudio/$version/logs:/opt/axway/policystudio/logs -v ~/axway/policystudio/$version/trace:/opt/axway/policystudio/trace $image /opt/axway/policystudio/policystudio &
}

parseOptions "$@"

# handle non-option arguments
if [[ "$help" == "y" ]] || [[ $# -lt "1" ]] || [[ -z "$version" ]]
then
  verbose=y
  printUsage
else
  if [[ "$verbose" == "n" ]]
  then
    exec >/dev/null 2>&1
  fi

  if isKasmVncVersion; then
    exec >/dev/tty
    mainKasmVnc
  else
    mainLegacy
  fi
fi
